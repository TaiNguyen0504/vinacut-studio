{
  "name": "vinacut-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "author": "VinaCAD Marketing",
  "description": "A desktop-first AI video studio for VinaCAD marketing demos.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.vinacad.vinacut",
    "productName": "VinaCut Studio",
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "public/samples/**",
      "dist/samples/**"
    ],
    "files": [
      "dist/**/*",
      "!dist/win-unpacked/**",
      "!dist/*.exe",
      "!dist/*.blockmap",
      "!dist/latest*.yml",
      "electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/vinacad.ico",
      "artifactName": "VinaCut-Studio-${version}-Setup.exe"
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "electron": "45.1.0",
    "electron-builder": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "latest"
  }
}
